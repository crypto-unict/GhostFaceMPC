+// One iteration's worth of daBits, read from the tape's compiled usage: the
+// program calls this once per iteration of a loop that runs ``iterations``
+// identical times and contains every daBit the tape consumes.
+template<class sint, class sgf2n>
+void Processor<sint, sgf2n>::prefetch_dabits(int iterations)
+{
+  if (iterations <= 0)
+    throw Processor_Error("prefetchdabit needs a positive iteration count");
+  auto usage = BaseMachine::get_offline_data_used();
+  auto field = sint::clear::field_type();
+  long long total = usage.files[field][DATA_DABIT];
+  long long bits = usage.files[field][DATA_BIT];
+  if (total < 0 or bits < 0)
+    throw Processor_Error("prefetchdabit: daBit usage of the tape is unknown");
+  if (sint::LivePrep::bits_from_dabits())
+    total += bits;
+  if (total % iterations != 0)
+    throw Processor_Error("prefetchdabit: daBit usage " + to_string(total)
+        + " is not a multiple of " + to_string(iterations) + " iterations");
+  Procp.DataF.prefetch_dabits(total / iterations);
+}
+
+// Every buffer one iteration draws on, for an actively secure live
+// preprocessing: the edaBits of each width, the arithmetic random
+// bits a daBit is drawn from where the protocol makes daBits from bits, and
+// the binary triples of the AND gates.  The order is the dependency order --
+// strict edaBits consume bits and binary triples while they are generated --
+// and every count carries slack, because a vector of n bits consumes whole
+// 64-bit words and the leftover simply serves the next iteration.
+template<class sint, class sgf2n>
+void Processor<sint, sgf2n>::prefetch_prep(int iterations)
+{
+  if (iterations <= 0)
+    throw Processor_Error("prefetchprep needs a positive iteration count");
+  auto usage = BaseMachine::get_offline_data_used();
+  auto share = [&](long long total, const string& what)
+  {
+    if (total < 0)
+      throw Processor_Error("prefetchprep: " + what + " usage is unknown");
+    return size_t(DIV_CEIL(total, iterations));
+  };
+  auto slack = [](size_t n) { return n ? n + n / 20 + 1024 : 0; };
+
+  map<pair<bool, int>, long long> edabits;
+  for (auto& x : usage.edabits)
+    if (x.second)
+      edabits[x.first] = slack(share(x.second, "edaBit"));
+  if (not edabits.empty())
+    Procp.DataF.prefetch_edabits(edabits);
+
+  auto field = sint::clear::field_type();
+  size_t dabits = share(usage.files[field][DATA_DABIT], "daBit");
+  size_t bits = share(usage.files[field][DATA_BIT], "bit");
+  if (sint::LivePrep::dabits_from_bits())
+  {
+    if (dabits + bits)
+      Procp.DataF.prefetch_bits(slack(dabits + bits));
+  }
+  else if (sint::LivePrep::bits_from_dabits())
+  {
+    if (dabits + bits)
+      Procp.DataF.prefetch_dabits(slack(dabits + bits));
+  }
+  else
+  {
+    if (dabits)
+      Procp.DataF.prefetch_dabits(slack(dabits));
+    if (bits)
+      Procp.DataF.prefetch_bits(slack(bits));
+  }
+
+  size_t and_bits = share(usage.files[DATA_GF2][DATA_TRIPLE], "binary triple");
+  if (and_bits)
+    DataF.DataFb.prefetch_triples(slack(DIV_CEIL(and_bits, 64)));
+
+  Procp.DataF.finish_prefetch();
+}
