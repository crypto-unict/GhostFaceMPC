+// Fill the daBit buffer ahead of the computation that consumes it, so that
+// no refill (and none of its rounds) runs inside the online phase.  Each
+// refill generates exactly the deficit, capped to bound the memory a single
+// batch needs; the work is accounted to the preprocessing timer like any
+// lazy refill, so a surrounding timer reports it as offline.
+template<class T>
+void BufferPrep<T>::prefetch_dabits(size_t n)
+{
+    const size_t chunk = size_t(1) << 21;
+    InScope in_scope(this->do_count, false, *this);
+    int old_buffer_size = this->buffer_size;
+    while (dabits.size() < n)
+    {
+        this->buffer_size = int(min(chunk, n - dabits.size()));
+        buffer_dabits(0);
+    }
+    this->buffer_size = old_buffer_size;
+    if (OnlineOptions::singleton.has_option("verbose_dabit"))
+        fprintf(stderr, "prefetched daBits: %zu buffered for %zu\n",
+                dabits.size(), n);
+}
+
+// The same ahead-of-time filling for the other buffers a request can draw on
+// as well.  Random bits append per refill, so the deficit is requested
+// directly.  Triples do not: a refill of the shuffle-and-sacrifice generators
+// *replaces* the buffer, so the held ones are set aside and put back.
+template<class T>
+void BufferPrep<T>::prefetch_bits(size_t n)
+{
+    const size_t chunk = size_t(1) << 21;
+    InScope in_scope(this->do_count, false, *this);
+    int old_buffer_size = this->buffer_size;
+    while (bits.size() < n)
+    {
+        this->buffer_size = int(min(chunk, n - bits.size()));
+        buffer_bits();
+    }
+    this->buffer_size = old_buffer_size;
+    if (OnlineOptions::singleton.has_option("verbose_dabit"))
+        fprintf(stderr, "prefetched bits: %zu buffered for %zu\n",
+                bits.size(), n);
+}
+
+template<class T>
+void BufferPrep<T>::prefetch_triples(size_t n)
+{
+    InScope in_scope(this->do_count, false, *this);
+    while (triples.size() < n)
+    {
+        auto held = std::move(triples);
+        triples.clear();
+        buffer_triples();
+        triples.insert(triples.end(), held.begin(), held.end());
+    }
+    if (OnlineOptions::singleton.has_option("verbose_dabit"))
+        fprintf(stderr, "prefetched triples: %zu buffered for %zu\n",
+                triples.size(), n);
+}
+
+template<class T>
+void BufferPrep<T>::prefetch_edabits(const map<pair<bool, int>, long long>& need)
+{
+    InScope in_scope(this->do_count, false, *this);
+    for (auto& required : need)
+    {
+        auto held = [&]()
+        {
+            size_t count = my_edabits[required.first].size();
+            for (auto& x : edabits[required.first])
+                count += x.size();
+            return count;
+        };
+        while (held() < size_t(required.second))
+            buffer_edabits_with_queues(required.first.first,
+                    required.first.second);
+        if (OnlineOptions::singleton.has_option("verbose_dabit"))
+            fprintf(stderr, "prefetched %s edaBits of %d bits: %zu for %lld\n",
+                    required.first.first ? "strict" : "loose",
+                    required.first.second, held(), required.second);
+    }
+}
