+@base.vectorize
+class shrsi2(base.ClearShiftInstruction):
+    """ Bitwise right shift of the *two-summand* regrouping of a replicated
+    secret register (vector) by a constant immediate value.
+
+    :class:`shrsi` shifts the three additive summands of a replicated sharing
+    separately, so a truncation identity built on it carries corrections in
+    ``{0,1,2}`` and pays two bit injections for each of them.  This
+    instruction shifts the two-summand regrouping instead -- the same one
+    ``split_to_n_summands(k, 2)`` produces -- so the corrections are single
+    bits.  The result is not a sharing of the right shift of the secret value
+    either: it still needs the two carries computed over the split columns.
+
+    Only replicated three-party rings implement it.  It sends one ring element
+    from player 0 to player 1 and opens nothing.
+
+    :param: result (sint)
+    :param: first operand (sint)
+    :param: second operand (int)
+
+    """
+    __slots__ = []
+    code = base.opcodes['SHRSI2']
+    arg_format = ['sw','s','i']
+
+class prefetchdabit(base.Instruction):
+    """ Generate, now, the daBits of one iteration of a loop.
+
+    The virtual machine reads the daBit usage the compiler recorded for the
+    whole tape, divides it by the iteration count, and fills its daBit buffer
+    up to that many before returning.  A loop that calls this at the top of
+    each of its ``iterations`` identical iterations, and that contains every
+    daBit the tape consumes, therefore never refills its buffer inside the
+    iteration: the generation, and its rounds, happen here.  The buffer is the
+    calling thread's.
+
+    :param: iterations (int)
+
+    """
+    __slots__ = []
+    code = base.opcodes['PREFETCHDABIT']
+    arg_format = ['i']
+
+class prefetchprep(base.Instruction):
+    """ Generate, now, all the preprocessing of one iteration of a loop.
+
+    The actively secure counterpart of :class:`prefetchdabit`: the virtual
+    machine divides the tape's compiled usage by the iteration count and fills
+    every buffer one iteration draws on -- the edaBits of each width, the
+    random bits a daBit is drawn from, and the binary triples of the AND gates
+    -- before returning, then settles the checks the generation left pending.
+    Each count carries a small slack, which the next iteration consumes.  The
+    buffers are the calling thread's.
+
+    :param: iterations (int)
+
+    """
+    __slots__ = []
+    code = base.opcodes['PREFETCHPREP']
+    arg_format = ['i']
+
