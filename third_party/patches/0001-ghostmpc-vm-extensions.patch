+
+    template<class U>
+    static void shrsi2(SubProcessor<U>& proc, const Instruction& inst)
+    {
+        shrsi2(proc, inst, T::prime_field);
+    }
+
+    template<class U>
+    static void shrsi2(SubProcessor<U>&, const Instruction&,
+            true_type)
+    {
+        throw runtime_error("shrsi2 not implemented");
+    }
+
+    // Local right shift of the *two-summand* regrouping of a replicated
+    // sharing (ghostmpc).
+    //
+    // ``shrsi`` shifts the three additive summands separately, which is why
+    // the truncation identity built on it needs carries in {0,1,2} and hence
+    // four bit injections.  Party i holds (x_i, x_{i-1}), so P0 -- and only
+    // P0 -- knows A = x_0 + x_2, while B = x_1 is held by both P1 (index 0)
+    // and P2 (index 1).  That is exactly the decomposition
+    // ``split_to_n_summands(k, 2)`` uses, so the single-bit carries computed
+    // over its columns correct exactly this shift.
+    //
+    // The shifted summands are re-shared as (t_A - rho, t_B, rho) with rho
+    // drawn from the PRNG P0 shares with P2, so only ``t_A - rho`` travels,
+    // from P0 to P1: one ring element in one round.  P1 does not hold that
+    // PRNG, so its view is uniform; nothing is opened and no party learns a
+    // value it did not already hold.
+    //
+    // The re-shared summand has a single holder, which is why this is a
+    // semi-honest primitive: a corrupt P0 could send a different value from
+    // the one it keeps and no party could contradict it.  Actively secure
+    // replicated protocols use a different protocol object, without the shared
+    // PRNGs, so the body below is only instantiated where it is meaningful and
+    // every other share type gets the same runtime refusal as an unsupported
+    // instruction.
+    template<class U>
+    static void shrsi2(SubProcessor<U>& proc, const Instruction& inst,
+            false_type)
+    {
+        if constexpr (not requires { proc.protocol.shared_prngs; })
+        {
+            (void) inst;
+            throw runtime_error(
+                    "shrsi2 is only available to a protocol with the "
+                    "replicated shared PRNGs");
+        }
+        else
+        {
+        auto& P = proc.P;
+        auto& prngs = proc.protocol.shared_prngs;
+        const int shift = inst.get_n();
+        const int size = inst.get_size();
+        octetStream os;
+        switch (P.my_num())
+        {
+        case 0:
+            for (int i = 0; i < size; i++)
+            {
+                auto source = proc.get_S_ref(inst.get_r(1) + i);
+                T rho;
+                rho.randomize(prngs[1]);
+                T masked = ((source[0] + source[1]) >> shift) - rho;
+                masked.pack(os);
+                auto& dest = proc.get_S_ref(inst.get_r(0) + i);
+                dest[0] = masked;
+                dest[1] = rho;
+            }
+            P.send_to(1, os);
+            break;
+        case 1:
+            P.receive_player(0, os);
+            for (int i = 0; i < size; i++)
+            {
+                auto source = proc.get_S_ref(inst.get_r(1) + i);
+                T masked;
+                masked.unpack(os);
+                auto& dest = proc.get_S_ref(inst.get_r(0) + i);
+                dest[0] = source[0] >> shift;
+                dest[1] = masked;
+            }
+            break;
+        case 2:
+            for (int i = 0; i < size; i++)
+            {
+                auto source = proc.get_S_ref(inst.get_r(1) + i);
+                T rho;
+                rho.randomize(prngs[0]);
+                auto& dest = proc.get_S_ref(inst.get_r(0) + i);
+                dest[0] = rho;
+                dest[1] = source[1] >> shift;
+            }
+            break;
+        }
+        }
+    }
 };
 
